# 官方发布固件安全配置。首次启动会写入不可逆 eFuse，只能用于已确认量产流程的设备。
# 构建前必须在项目根目录准备未纳入 Git 的 secure_boot_signing_key.pem：
# espsecure.py generate_signing_key --version 2 --scheme ecdsa256 secure_boot_signing_key.pem

# Secure Boot V2 使用 ECDSA-256 签名，并在普通 flash 命令和合并固件中包含已签名 bootloader。
CONFIG_SECURE_BOOT=y
CONFIG_SECURE_BOOT_V2_ENABLED=y
CONFIG_SECURE_SIGNED_APPS_ECDSA_V2_SCHEME=y
CONFIG_SECURE_BOOT_ECDSA_KEY_LEN_256_BITS=y
CONFIG_SECURE_BOOT_BUILD_SIGNED_BINARIES=y
CONFIG_SECURE_BOOT_SIGNING_KEY="secure_boot_signing_key.pem"
CONFIG_SECURE_BOOT_FLASH_BOOTLOADER_DEFAULT=y

# 量产发布使用 Release 模式 Flash Encryption，首次启动后禁止明文 UART 重写 Flash。
CONFIG_SECURE_FLASH_ENC_ENABLED=y
CONFIG_SECURE_FLASH_ENCRYPTION_AES128=y
CONFIG_SECURE_FLASH_ENCRYPTION_MODE_RELEASE=y

# IDF 6.0.2 在启用 Flash 加密时会默认打开 NVS 加密并选择 HMAC 方案
# （NVS_SEC_HMAC_EFUSE_KEY_ID 默认 -1，编译报 out of range）。Release 模式 Flash
# 已全盘加密，NVS 数据静态安全由 Flash Encryption 保证，因此关闭 NVS 加密层，
# 避免占用 eFuse HMAC key block（该块需产线预烧 key，影响量产流程）。
CONFIG_NVS_ENCRYPTION=n

# 防止安装安全版本更低的历史固件。出现必须禁止回退的漏洞时递增安全版本。
CONFIG_BOOTLOADER_APP_ANTI_ROLLBACK=y
CONFIG_BOOTLOADER_APP_SECURE_VERSION=1
CONFIG_BOOTLOADER_APP_SEC_VER_SIZE_EFUSE_FIELD=16
