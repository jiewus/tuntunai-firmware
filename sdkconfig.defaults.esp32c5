
# Tuntun Moji2 板载 16 MB Flash 使用 QIO 读取。
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

# ESP32-C5 最高运行频率，空闲时由 PowerSaveTimer 调整电源策略。
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Tuntun Moji2 板载 Quad PSRAM。WakeNet9s 初始化会分配较大的模型工作区，
# 如果没有启用 PSRAM，只靠 ESP32-C5 片内 RAM 会在联网后首次启用唤醒词时耗尽内存。
# 将 PSRAM 加入默认 malloc 内存池，并允许天气、备忘录、MCP、通知等非实时业务任务使用
# 外部任务栈。音频、Wi-Fi、显示和涉及 Flash/NVS 写入的任务仍必须使用片内 SRAM。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# C5 内部 RAM 较紧，进一步限制 Wi-Fi/LwIP 缓冲并允许 TLS 及时释放配置数据。
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=3
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_RX_BA_WIN=3
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

# 唯一保留的中文 WakeNet9s 模型，与 generated_assets.bin 内容保持一致。
CONFIG_SR_WN_WN9S_NIHAOXIAOZHI=y
CONFIG_USE_ESP_WAKE_WORD=y
