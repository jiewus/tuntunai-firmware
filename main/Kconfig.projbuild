# 本文件只定义所有 TuntunLife 板型共享的产品配置项。板型由 CMake BOARD_TYPE 选择。
menu "TuntunLife Assistant"

config OTA_URL
    string "Default OTA URL"
    # 设备启动时向该服务查询协议参数、激活状态和新固件地址。
    default "https://your-ota.example.com/xiaozhi/ota/"

config TUNTUN_API_URL
    string "TuntunLife API URL"
    # 设备绑定、天气、备忘录和动态 MCP 能力统一使用的自建平台根地址。
    default "https://api.tuntun.life"

choice
    prompt "Flash Assets"
    # 决定 idf.py flash 是否同时写入字体、表情和 WakeNet 模型资源分区。
    default FLASH_DEFAULT_ASSETS

    config FLASH_NONE_ASSETS
        bool "Do not flash assets"
    config FLASH_DEFAULT_ASSETS
        bool "Flash default Chinese assets"
    config FLASH_CUSTOM_ASSETS
        bool "Flash custom assets"
endchoice

config CUSTOM_ASSETS_FILE
    string "Custom Assets File"
    # 可使用 URL、绝对路径或相对 main/ 的路径。
    default "assets.bin"
    depends on FLASH_CUSTOM_ASSETS

choice WAKE_WORD_TYPE
    prompt "Wake Word"
    # 具体模型和 AFE 能力由板型 sdkconfig.defaults 选择。
    default USE_ESP_WAKE_WORD

    config WAKE_WORD_DISABLED
        bool "Disabled"
    config USE_ESP_WAKE_WORD
        bool "ESP-SR wake word"
endchoice

config USE_AUDIO_DEBUGGER
    bool "Enable audio debugger"
    # 开启后会把麦克风 PCM 通过 UDP 发往下方配置的开发机地址。
    default n

config AUDIO_DEBUG_UDP_SERVER
    string "Audio debug UDP server"
    default "192.168.2.100:8000"
    depends on USE_AUDIO_DEBUGGER

config USE_HOTSPOT_WIFI_PROVISIONING
    bool
    # 本产品固定使用 SoftAP + 网页方式配置 Wi-Fi。
    default y

config RECEIVE_CUSTOM_MESSAGE
    bool "Enable custom server messages"
    default n

endmenu
